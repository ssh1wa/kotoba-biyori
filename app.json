{
  "expo": {
    "name": "ことば日和",
    "slug": "kotoba-biyori",
    "scheme": "kotobabiyori",
    "version": "1.7.0-beta.1",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kotobabiyori.app",
      "versionCode": 27,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F3",
        "foregroundImage": "./assets/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon-v2.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F3",
          "image": "./assets/splash-icon-v2.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing"
    ]
  }
}
